---
import FlowField from "@components/FlowField.astro";
import Cursor from "@components/Cursor.astro";
import Rail from "@components/Rail.astro";
import Navbar from "@components/NavBar.astro";
import Footer from "@components/Footer.astro";
import SEO from "@components/SEO.astro";
import "../styles/global.css";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  showNavbar?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Nicolás di Rago — Frontend Engineer",
  image = "/main.webp",
  article = false,
  showNavbar = true,
  breadcrumbs = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.nicolasdirago.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme initialization script - prevents flash -->
    <script is:inline>
      (function() {
        const THEME_KEY = 'portfolio-theme-mode';
        // try/catch: localStorage throws in Safari private browsing
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem(THEME_KEY);
        } catch {}
        let theme = 'light';

        if (storedTheme === 'dark' || storedTheme === 'light') {
          theme = storedTheme;
        } else {
          // Check system preference
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = prefersDark ? 'dark' : 'light';
        }

        document.documentElement.setAttribute('data-theme', theme);

        // Store the detected theme if it wasn't already stored
        if (!storedTheme) {
          try {
            localStorage.setItem(THEME_KEY, theme);
          } catch {}
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      breadcrumbs={breadcrumbs}
    />

    <!-- Preload only critical above-the-fold fonts -->
    <link rel="preload" href="/fonts/SpaceGrotesk-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <FlowField />
    <Cursor />
    <Rail />

    <div class="content">
      {showNavbar && <Navbar />}

      <main id="main-content">
        <slot />
      </main>

      <Footer />
    </div>

    <!-- Global theme toggle script -->
    <script is:inline>
      // Only initialize once
      if (!window.__themeInitialized) {
        window.__themeInitialized = true;

        // Make theme utilities available globally
        window.toggleTheme = function() {
          const currentTheme = document.documentElement.getAttribute('data-theme');
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          // try/catch: localStorage throws in Safari private browsing
          try {
            localStorage.setItem('portfolio-theme-mode', newTheme);
          } catch {}

          // Dispatch custom event for components to react to theme change
          window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
        };

        window.getTheme = function() {
          return document.documentElement.getAttribute('data-theme') || 'light';
        };
      }
    </script>
  </body>
</html>

<style>
  .content {
    position: relative;
    z-index: 3;
  }
</style>

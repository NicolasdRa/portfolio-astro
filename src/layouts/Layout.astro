---
import { ViewTransitions } from 'astro:transitions';
import SEO from "../components/SEO.astro";
import "../styles/global.css";

// Import React components
import Navbar from "@components/NavBar/NavBar";
import SocialLinks from "@components/SocialLinks/SocialLinks";
import CustomCursor from "@components/CustomCursor/CustomCursor";
import Footer from "@components/Footer/Footer";
import ThemeToggle from "@components/ThemeToggle/ThemeToggle";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  showNavbar?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Nicolás di Rago - Full-stack Web Developer",
  image = "/main.webp",
  article = false,
  showNavbar = true,
  breadcrumbs = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nicolasdirago.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme initialization script - prevents flash -->
    <script is:inline>
      (function() {
        const THEME_KEY = 'portfolio-theme-mode';
        const storedTheme = localStorage.getItem(THEME_KEY);
        let theme = 'light';

        if (storedTheme === 'dark' || storedTheme === 'light') {
          theme = storedTheme;
        } else {
          // Check system preference
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = prefersDark ? 'dark' : 'light';
        }

        document.documentElement.setAttribute('data-theme', theme);

        // Store the detected theme if it wasn't already stored
        if (!storedTheme) {
          localStorage.setItem(THEME_KEY, theme);
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      breadcrumbs={breadcrumbs}
    />

    <ViewTransitions />

    <!-- Performance Hints -->
    <!-- Prefetch critical navigation pages -->
    <link rel="prefetch" href="/about" />
    <link rel="prefetch" href="/projects" />

    <!-- Preload critical assets -->
    <link rel="preload" href={image} as="image" type="image/webp" />

    <!-- Preload only critical above-the-fold fonts -->
    <!-- Source Code Pro: body text, navbar, hero description -->
    <!-- Space Grotesk: all headings (h1-h6) -->
    <!-- Oswald: hero title "nicolás di rago" -->
    <!-- Note: Italic variant NOT preloaded - only used below fold in tech stacks and <em> tags -->
    <link rel="preload" href="/fonts/SourceCodePro-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Oswald-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <!-- Custom Cursor - Always visible on desktop -->
    <CustomCursor client:only="react" transition:persist />

    <!-- Navigation - Conditionally rendered based on page -->
    {showNavbar && <Navbar client:only="react" />}

    <!-- Social Links - Fixed position -->
    <SocialLinks client:only="react" transition:persist />

    <!-- Theme Toggle - Fixed position -->
    <ThemeToggle client:only="react" transition:persist />

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <Footer client:only="react" transition:persist />

    <!-- Global theme toggle script -->
    <script>
      // Make theme utilities available globally
      window.toggleTheme = function() {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('portfolio-theme-mode', newTheme);

        // Dispatch custom event for components to react to theme change
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
      };

      window.getTheme = function() {
        return document.documentElement.getAttribute('data-theme') || 'light';
      };

      // Handle theme persistence during View Transitions
      document.addEventListener('astro:before-swap', (ev) => {
        // Get current theme before swap
        const currentTheme = document.documentElement.getAttribute('data-theme');

        // Set theme on new document
        ev.newDocument.documentElement.setAttribute('data-theme', currentTheme);
      });

      // Ensure theme is applied after page load
      document.addEventListener('astro:page-load', () => {
        const THEME_KEY = 'portfolio-theme-mode';
        const storedTheme = localStorage.getItem(THEME_KEY);

        if (storedTheme) {
          document.documentElement.setAttribute('data-theme', storedTheme);
        }
      });
    </script>
  </body>
</html>

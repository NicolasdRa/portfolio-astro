---
import Layout from '../layouts/Layout.astro';
import CustomLink from '../components/CustomLink/CustomLink';
---

<Layout title="Success" showNavbar={false}>
	<main class="success-page">
		<div class="container">
			<h1>your message has been received</h1>
			<CustomLink url="/" text="back home" type="internal" client:only="react" />
		</div>
	</main>
</Layout>

<style>
	.success-page {
		display: grid;
		place-items: center;
		text-align: center;
		min-height: 100vh;
		margin: 0 5vw;
		animation: fadeIn 0.8s ease-out;
		background-color: var(--color-background);
		color: var(--color-text);
	}

	h1 {
		font-family: var(--font-secondary);
		font-size: 4rem;
		font-weight: lighter;
		margin-bottom: 5rem;
		color: var(--color-gray-1);
	}

	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 3rem;
		}
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 2.5rem;
		}
	}
</style>

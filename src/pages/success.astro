---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Message sent" showNavbar={false}>
	<main class="success-page">
		<div class="container">
			<span class="lbl">// sent</span>
			<h1>your message has been received</h1>
			<a class="back" href="/" data-h>back home →</a>
		</div>
	</main>
</Layout>

<style>
	.success-page {
		display: grid;
		place-items: center;
		text-align: center;
		min-height: 100vh;
		margin: 0 5vw;
	}

	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}

	h1 {
		font-family: var(--font-sans);
		font-size: clamp(2rem, 5.5vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		max-width: 20ch;
	}

	.back {
		font-family: var(--font-mono);
		font-size: 13.5px;
		color: var(--acc);
		border-bottom: 1px solid var(--acc);
		padding-bottom: 4px;
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>

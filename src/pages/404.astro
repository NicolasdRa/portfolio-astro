---
import Layout from '../layouts/Layout.astro';
import CustomLink from "../components/CustomLink.astro";
---

<Layout title="Not Found" showNavbar={false}>
	<main class="not-found-page">
		<div class="container">
			<h1>dead end...</h1>
			<CustomLink url="/" text="back home" type="internal" />
		</div>
	</main>
</Layout>

<style>
	.not-found-page {
		display: grid;
		place-items: center;
		text-align: center;
		min-height: 100vh;
		margin: 0 5vw;
		animation: fadeIn 0.8s ease-out;
	}

	h1 {
		font-family: var(--font-secondary);
		font-size: 4rem;
		font-weight: lighter;
		margin-bottom: 5rem;
	}

	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 3rem;
		}
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 2.5rem;
		}
	}
</style>

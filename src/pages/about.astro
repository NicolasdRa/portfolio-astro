---
import CustomLink from "@components/CustomLink.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout
	title="About Nicolás di Rago"
	description="Learn more about Nicolás di Rago, a Berlin-based full-stack web developer at Nuuk GmbH. creating high-performance web applications with React, Next, Solid TypeScript, and Node.js."
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'About', url: '/about' }
	]}
	showNavbar={true}>
	<div class="about-page">
		<div class="container">
			<h1>a detailed about page is coming soon...</h1>
			<CustomLink url="/" text="back home" type="internal" />
		</div>
	</div>
</Layout>

<style>
	.about-page {
		display: grid;
		place-items: center;
		text-align: center;
		min-height: 100vh;
		margin: 0 5vw;
		animation: fadeIn 0.8s ease-out;
	}

	h1 {
		font-family: var(--font-secondary);
		font-size: 4rem;
		font-weight: lighter;
		margin-bottom: 5rem;
	}

	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 3rem;
		}
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 2.5rem;
		}
	}
</style>

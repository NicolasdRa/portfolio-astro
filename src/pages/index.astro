---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Sections/HeroSection.astro';
import AboutSection from '../components/Sections/AboutSection.astro';
import WorkSection from '../components/Sections/WorkSection.astro';
import ProjectsSection from '../components/Sections/ProjectsSection.astro';
import ContactSection from '../components/Sections/ContactSection.astro';
---

<Layout
	title="Nicolás di Rago - Full-stack Web Developer"
	description="Berlin-based full-stack web developer at Nuuk GmbH specializing in React, Next.js, NestJS, and TypeScript. Building production-ready web applications with modern frameworks like Solid.js, Astro, and cutting-edge technologies."
	showNavbar={true}>
	<!-- Hero Section - Server rendered, interactive image on desktop only -->
	<HeroSection />

	<!-- About Section - Server rendered -->
	<AboutSection />

	<!-- Work Section - Server rendered -->
	<WorkSection />

	<!-- Projects Section - Server rendered -->
	<ProjectsSection />

	<!-- Contact Section - Server rendered -->
	<ContactSection />
</Layout>

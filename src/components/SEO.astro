---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  article?: boolean;
  publishedTime?: string;
  author?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = 'Nicolás di Rago — Frontend Engineer',
  description = 'Berlin-based frontend engineer at Nuuk GmbH — backend-capable, five years shipping production web apps front to back.',
  keywords = [
    'frontend engineer',
    'react developer',
    'typescript',
    'javascript',
    'full-stack developer',
    'web development',
    'frontend developer',
    'backend developer',
    'node.js',
    'portfolio',
    'nicolás di rago',
    'berlin web developer',
    'frontend developer berlin',
    'full-stack developer germany',
    'react developer berlin',
    'freelance developer berlin'
  ],
  image = '/main.webp',
  article = false,
  publishedTime,
  author = 'Nicolás di Rago',
  breadcrumbs = []
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://www.nicolasdirago.dev';
const siteTitle = 'Nicolás di Rago — Frontend Engineer';
const twitterUsername = '@nicolasdiRago';

// Format the page title
const formattedTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;

// Ensure image URL is absolute
const absoluteImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Current page URL
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content={author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} - Portfolio preview`} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content="en_US" />

{article && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
  <meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:image:alt" content={`${title} - Portfolio preview`} />
<meta name="twitter:creator" content={twitterUsername} />
<meta name="twitter:site" content={twitterUsername} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Theme Color -->
<meta name="theme-color" content="#0c0b0a" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    // WebSite schema
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      "url": siteUrl,
      "name": siteTitle,
      "description": description,
      "publisher": {
        "@id": `${siteUrl}#person`
      },
      "inLanguage": "en-US"
    },
    // WebPage schema
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": formattedTitle,
      "isPartOf": {
        "@id": `${siteUrl}#website`
      },
      "about": {
        "@id": `${siteUrl}#person`
      },
      "description": description,
      "image": absoluteImageUrl,
      "inLanguage": "en-US",
      ...(article && publishedTime ? {
        "datePublished": publishedTime,
        "dateModified": publishedTime
      } : {})
    },
    // Person/Developer schema
    {
      "@type": ["Person", "ProfilePage"],
      "@id": `${siteUrl}#person`,
      "name": author,
      "url": siteUrl,
      "image": absoluteImageUrl,
      "jobTitle": "Frontend Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Nuuk GmbH"
      },
      "knowsAbout": [
        "React",
        "TypeScript",
        "JavaScript",
        "Node.js",
        "Web Development",
        "Frontend Development",
        "Backend Development",
        "Full-stack Development"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Berlin",
        "addressCountry": "DE"
      },
      "sameAs": [
        "https://github.com/NicolasdRa",
        "https://www.linkedin.com/in/nicol%C3%A1s-di-rago-tango-code",
        "https://x.com/nicolsdi_rago2"
      ],
      "email": "mailto:ndr@nuuk.de"
    }
  ]
})} />

<!-- Breadcrumb Schema (if breadcrumbs provided) -->
{breadcrumbs.length > 0 && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "item": `${siteUrl}${item.url}`
    }))
  })} />
)}
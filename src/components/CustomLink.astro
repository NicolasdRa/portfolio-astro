---
interface Props {
  url: string;
  type: 'link' | 'button' | 'internal';
  text: string;
  download?: boolean;
}

const { url, type, text, download = false } = Astro.props;
---

<div class="wrapper" data-custom-link>
  {type === 'link' && (
    <a href={url} download={download}>
      {text}
    </a>
  )}

  {type === 'internal' && (
    <a href={url}>
      {text}
    </a>
  )}

  {type === 'button' && (
    <button type="submit">
      {text}
    </button>
  )}
</div>

<script>
  function initCustomLinks() {
    const links = document.querySelectorAll('[data-custom-link]');

    links.forEach((wrapper) => {
      const element = wrapper.querySelector('a, button');
      if (!element) return;

      element.addEventListener('mouseenter', () => {
        window.dispatchEvent(new CustomEvent('cursor-change', { detail: { type: 'hover' } }));
      });

      element.addEventListener('mouseleave', () => {
        window.dispatchEvent(new CustomEvent('cursor-change', { detail: { type: 'default' } }));
      });
    });
  }

  initCustomLinks();

  document.addEventListener('astro:page-load', () => {
    initCustomLinks();
  });
</script>

<style>
  .wrapper {
    display: inline-block;
    position: relative;
    width: max-content;
    line-height: 1;
    text-decoration: none;
    font-size: 0.875rem;
    will-change: transform;
    transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    border-radius: 2px;
  }

  :global([data-theme="dark"]) .wrapper {
    color: var(--color-gray-4);
    background-color: var(--color-gray-1);
    border: 1px solid var(--color-gray-1);
  }

  :global([data-theme="light"]) .wrapper {
    color: var(--color-background);
    background-color: var(--color-gray-1);
    border: 1px solid var(--color-gray-1);
  }

  .wrapper a {
    display: block;
    padding: 0.875rem 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .wrapper button {
    padding: 0.875rem 1.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  :global([data-theme="dark"]) .wrapper button {
    color: var(--color-gray-4);
  }

  :global([data-theme="light"]) .wrapper button {
    color: var(--color-background);
  }

  .wrapper:hover {
    background-color: var(--color-background);
    transform: translateY(-2px);
    transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  :global([data-theme="dark"]) .wrapper:hover,
  :global([data-theme="light"]) .wrapper:hover {
    color: var(--color-gray-1);
  }

  :global([data-theme="dark"]) .wrapper:hover button,
  :global([data-theme="light"]) .wrapper:hover button {
    color: var(--color-gray-1);
  }

  .wrapper:active {
    color: var(--color-primary-3);
    background-color: var(--color-background);
    border: 1px solid var(--color-primary-3);
    transform: translateY(1px);
    transition: transform 125ms;
  }

  .wrapper:active button {
    color: var(--color-primary-3);
  }

  @media screen and (max-width: 600px) {
    .wrapper {
      font-size: 0.8125rem;
    }

    .wrapper a,
    .wrapper button {
      padding: 1rem 1.5625rem;
    }
  }

  @media screen and (max-width: 400px) {
    .wrapper {
      font-size: 0.75rem;
    }

    .wrapper a,
    .wrapper button {
      padding: 0.9375rem 1.375rem;
    }
  }
</style>

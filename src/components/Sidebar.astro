---
import links from '../constants/links';
import socialLinks from '../constants/social_links';
import Icon from './Icon.astro';

// Close icon SVG
const closeIcon = `<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/>`;
---

<div class="wrapper" data-sidebar-wrapper>
  <aside class="sidebar" data-sidebar>
    <button
      class="close-btn"
      data-sidebar-close
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="close-icon" set:html={closeIcon} />
    </button>
    <div class="inner">
      <ul class="sidebar-links">
        {links.map((link) => (
          <li >
            <a
              href={link.url}
              class="sidebar-link"
              data-sidebar-link
            >
              <span class="link-number">0{link.id - 1}. </span>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="theme-toggle-button"
        data-theme-toggle
      >
        <span data-theme-text>light</span> mode
      </button>

      <ul class="social-links">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.url}
              class="social-link"
              aria-label={link.name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={link.icon} class="social-icon" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
</div>

<style>
  .wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 999;
    display: grid;
    place-items: center;
    visibility: hidden;
    pointer-events: none;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-foreground);
    z-index: 999;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateX(100%);
    transition: var(--transition-base);
  }

  @media screen and (min-width: 1024px) {
    .sidebar {
      transform: translateX(-100%);
    }
  }

  .sidebar.show {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateX(0);
  }

  .wrapper.show {
    visibility: visible;
    pointer-events: auto;
  }

  .close-btn {
    position: absolute;
    right: 4.75%;
    top: 2.25%;
    font-size: 2rem;
    background: transparent;
    border-color: transparent;
    border: none;
    color: var(--color-primary-3);
    cursor: none;
    transition: var(--transition-fast);
    padding: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn :global(.close-icon) {
    width: 2rem;
    height: 2rem;
  }

  .close-btn:hover {
    color: var(--color-primary-4);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    padding-left: 10%;
    width: 100%;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-bottom: 3.75rem;
  }

  .sidebar-links li {
    text-align: left;
    margin-bottom: 1rem;
  }

  .sidebar-link {
    display: block;
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    text-transform: uppercase;
    color: var(--color-background);
    /* letter-spacing: 0.0625rem; */
    transition: var(--transition-base);
    text-decoration: none;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .sidebar-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary-3);
    transition: width 0.3s ease;
  }

  .sidebar-link:hover {
    color: var(--color-primary-3);
  }

  .sidebar-link:hover::after {
    width: 100%;
  }

  .link-number {
    color: var(--color-primary-3);
    font-size: 1rem;
    margin-right: 0.5rem;
  }

  .theme-toggle-button {
    background: none;
    border: none;
    color: var(--color-gray-4);
    font-family: var(--font-primary);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin: 0 0 5rem 0;
    transition: var(--transition-base);
    text-transform: lowercase;
    cursor: none;
    position: relative;
    align-self: flex-start;
  }

  .theme-toggle-button:hover {
    color: var(--color-primary-3);
  }

  .social-links {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0;
    justify-content: space-between;
    width: 60%;
    max-width: 250px;
  }

  .social-link {
    font-size: 1.25rem;
    color: var(--color-gray-2);
    transition: var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-link :global(.social-icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .social-link:hover {
    color: var(--color-primary-3);
    transform: translateY(-2px);
  }

  @media screen and (min-width: 1024px) {
    .wrapper {
      display: grid;
    }

    .sidebar {
      width: 100%;
    }
  }
</style>

<script>
  function initSidebar() {
    const wrapper = document.querySelector('[data-sidebar-wrapper]') as HTMLElement;
    const sidebar = document.querySelector('[data-sidebar]') as HTMLElement;
    const closeBtn = document.querySelector('[data-sidebar-close]');
    const sidebarLinks = document.querySelectorAll('[data-sidebar-link]');
    const themeToggle = document.querySelector('[data-theme-toggle]');
    const themeText = document.querySelector('[data-theme-text]') as HTMLElement;

    if (!wrapper || !sidebar) return;

    // Theme management
    const getCurrentTheme = () => {
      return document.documentElement.getAttribute('data-theme') || 'light';
    };

    const updateThemeText = () => {
      if (themeText) {
        const currentTheme = getCurrentTheme();
        themeText.textContent = currentTheme === 'light' ? 'dark' : 'light';
      }
    };

    // Initialize theme text
    updateThemeText();

    // Listen for theme changes
    window.addEventListener('theme-changed', () => {
      updateThemeText();
    });

    // Theme toggle handler
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const currentTheme = getCurrentTheme();
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('portfolio-theme-mode', newTheme);
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
        updateThemeText();
      });
    }

    // Close sidebar
    const closeSidebar = () => {
      wrapper.classList.remove('show');
      sidebar.classList.remove('show');
      document.body.style.overflow = 'unset';
    };

    // Close button handler
    if (closeBtn) {
      closeBtn.addEventListener('click', closeSidebar);
    }

    // Close on link click
    sidebarLinks.forEach((link) => {
      link.addEventListener('click', closeSidebar);
    });

    // Listen for sidebar open event from Navbar
    window.addEventListener('sidebar-toggle', ((e: CustomEvent) => {
      const isOpen = e.detail.isOpen;

      if (isOpen) {
        wrapper.classList.add('show');
        sidebar.classList.add('show');
        document.body.style.overflow = 'hidden';
      } else {
        closeSidebar();
      }
    }) as EventListener);
  }

  // Initialize on page load
  initSidebar();

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:page-load', () => {
    initSidebar();
  });
</script>

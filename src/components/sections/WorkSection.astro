---
import jobs from "../../constants/jobs";
---

<div class="wrap">
  <section id="work">
    <div class="shead"><span class="n">02</span><h2>Experience</h2><span class="rule"></span></div>
    <div class="worklist">
      {jobs.map((job) => (
        <div class="wjob" data-h>
          <div class="yr">{job.years}</div>
          <div>
            <h3>{job.title}</h3>
            <div class="co">{job.company}</div>
            <p>{job.blurb}</p>
          </div>
          <div class="pl">{job.place}</div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .worklist {
    display: grid;
    gap: 0;
  }

  .wjob {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 26px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
    transition: padding 0.3s;
  }

  .wjob:last-child {
    border-bottom: 1px solid var(--line);
  }

  .wjob:hover {
    padding-left: 14px;
  }

  .wjob .yr {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--acc);
  }

  .wjob h3 {
    font-size: 20px;
    font-weight: 600;
  }

  .wjob .co {
    color: var(--dim);
    font-size: 14px;
    margin: 3px 0 9px;
  }

  .wjob p {
    color: var(--dim);
    font-size: 14.5px;
    max-width: 520px;
  }

  .wjob .pl {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    text-align: right;
  }

  @media (max-width: 700px) {
    .wjob {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .wjob .pl {
      text-align: left;
    }
  }
</style>

---
import projects from "../../constants/projects";
---

<div class="wrap">
  <section id="projects">
    <div class="shead"><span class="n">03</span><h2>Selected Work</h2><span class="rule"></span></div>
    <div class="projlist" data-accordion>
      {projects.map((project, index) => {
        const bodyId = `proj-body-${index}`;
        const isExternal = project.link.url !== "#";
        return (
          <div class="proj">
            <button
              type="button"
              class="proj-head"
              data-h
              data-acc-trigger
              aria-expanded="false"
              aria-controls={bodyId}
            >
              <span class="pn">{project.n}</span>
              <span class="proj-heading">
                <span class="ptitle">{project.title}</span>
                <span class="psub">{project.subtitle}</span>
              </span>
              <span class="pt"><span class="ptx">open</span><span class="pm"></span></span>
            </button>
            <div class="proj-body" id={bodyId}>
              <div class="proj-inner">
                <div>
                  {project.paragraphs.map((p) => <p>{p}</p>)}
                  <a
                    class="visit"
                    href={project.link.url}
                    data-h
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noreferrer" : undefined}
                  >
                    {project.link.text} →
                  </a>
                </div>
                <div>
                  <div class="dl">Stack &amp; role</div>
                  <div class="tech">
                    {project.stack.map((item) => <span>{item}</span>)}
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</div>

<noscript>
  <style is:inline>
    /* Without JS the accordion cannot open — render every panel expanded
       and hide the open/close affordance. */
    .proj-body {
      max-height: none !important;
    }
    .proj-head .pt {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .proj {
    border-top: 1px solid var(--line);
  }

  .projlist .proj:last-child {
    border-bottom: 1px solid var(--line);
  }

  .proj-head {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 24px;
    width: 100%;
    padding: 32px 0;
    align-items: baseline;
    transition: padding 0.3s;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
  }

  .proj-head:hover {
    padding-left: 14px;
  }

  .proj-head:hover .ptitle {
    color: var(--acc);
  }

  .proj .pn {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--faint);
  }

  .proj .proj-heading {
    display: block;
  }

  .proj .ptitle {
    display: block;
    font-size: clamp(28px, 4.2vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: color 0.25s;
  }

  .proj .psub {
    display: block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--dim);
    margin-top: 10px;
  }

  .proj .pt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
    align-self: center;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .proj .pm {
    width: 16px;
    height: 16px;
    position: relative;
    flex: none;
  }

  .proj .pm::before,
  .proj .pm::after {
    content: "";
    position: absolute;
    background: var(--acc);
    transition: 0.3s;
  }

  .proj .pm::before {
    top: 7.5px;
    left: 0;
    width: 16px;
    height: 1.5px;
  }

  .proj .pm::after {
    top: 0;
    left: 7.5px;
    width: 1.5px;
    height: 16px;
  }

  .proj.open .pm::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .proj-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.5, 0, 0.1, 1);
  }

  .proj-inner {
    padding: 0 0 40px 76px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 44px;
  }

  .proj-inner p {
    color: var(--dim);
    font-size: 15.5px;
    margin-bottom: 14px;
  }

  .proj-inner .dl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: 14px;
  }

  .proj-inner .tech span {
    display: block;
    font-size: 14px;
    color: var(--ink);
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }

  .proj-inner .visit {
    margin-top: 8px;
    display: inline-flex;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--acc);
    border-bottom: 1px solid var(--acc);
    padding-bottom: 4px;
    transition: gap 0.2s;
  }

  .proj-inner .visit:hover {
    gap: 14px;
  }

  @media (max-width: 700px) {
    .proj-head {
      grid-template-columns: 34px 1fr;
      gap: 14px;
    }

    .proj .pt {
      grid-column: 2;
    }

    .proj-inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-left: 0;
    }
  }
</style>

<script>
  function initAccordion() {
    const list = document.querySelector<HTMLElement>("[data-accordion]");
    if (!list) return;

    // Collapsed a11y state is applied here, not in the server markup, so the
    // noscript fallback (panels forced open) never carries aria-hidden/inert.
    for (const body of list.querySelectorAll<HTMLElement>(".proj-body")) {
      body.setAttribute("aria-hidden", "true");
      body.toggleAttribute("inert", true);
    }

    list.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-acc-trigger]");
      if (!trigger) return;

      const proj = trigger.closest<HTMLElement>(".proj");
      const body = trigger.nextElementSibling as HTMLElement | null;
      if (!proj || !body) return;

      const open = proj.classList.toggle("open");
      const inner = body.firstElementChild as HTMLElement | null;
      body.style.maxHeight = open && inner ? `${inner.scrollHeight}px` : "0";

      trigger.setAttribute("aria-expanded", String(open));
      body.setAttribute("aria-hidden", String(!open));
      body.toggleAttribute("inert", !open);

      const label = trigger.querySelector(".ptx");
      if (label) label.textContent = open ? "close" : "open";
    });

    // The measured max-height goes stale when the layout reflows (e.g. the
    // 700px one-column breakpoint) — re-measure open panels on resize.
    addEventListener("resize", () => {
      for (const body of list.querySelectorAll<HTMLElement>(".proj.open .proj-body")) {
        const inner = body.firstElementChild as HTMLElement | null;
        if (inner) body.style.maxHeight = `${inner.scrollHeight}px`;
      }
    });
  }

  initAccordion();
</script>

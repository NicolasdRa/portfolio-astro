<div class="wrap">
  <header class="hero">
    <div class="top-line">
      <span class="dash"></span>
      <span class="lbl">Frontend Engineer · Backend-Capable · Berlin</span>
    </div>
    <h1 class="hn">i build<br />web apps,<br /><span class="a">front&nbsp;to&nbsp;back.</span></h1>
    <p class="lede">
      I'm <b>Nicolás di Rago</b>. Five years making web apps at <b>nuuk gmbh</b> in Berlin — frontend-led,
      and at home in the backend.
    </p>
    <div class="cta">
      <a class="go" href="#contact" data-h>Get in touch →</a>
      <a class="go2" href="#projects" data-h>See the work</a>
    </div>
    <div class="cue">SCROLL<div class="bar"></div></div>
  </header>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 130px 0 80px;
  }

  .hero .top-line {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
  }

  .hero .dash {
    width: 38px;
    height: 1px;
    background: var(--acc);
  }

  .hn {
    font-size: clamp(46px, 10.5vw, 132px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .hn .a {
    color: var(--acc);
  }

  .hero .lede {
    margin-top: 34px;
    max-width: 540px;
    font-size: clamp(16.5px, 2vw, 19px);
    color: var(--dim);
  }

  .hero .lede b {
    color: var(--ink);
    font-weight: 500;
  }

  .hero .cta {
    margin-top: 38px;
    display: flex;
    gap: 26px;
    align-items: center;
    flex-wrap: wrap;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--bg);
    background: var(--acc);
    padding: 13px 22px;
    transition: 0.2s;
  }

  .go:hover {
    gap: 16px;
  }

  .go2 {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 4px;
    transition: 0.2s;
  }

  .go2:hover {
    border-color: var(--acc);
    color: var(--acc);
  }

  .cue {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--dim);
    text-align: center;
  }

  .cue .bar {
    width: 1px;
    height: 38px;
    background: linear-gradient(var(--acc), transparent);
    margin: 10px auto 0;
    animation: drop 2.2s infinite;
  }

  @keyframes drop {
    0% {
      opacity: 0;
      transform: scaleY(0.2);
    }
    45% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateY(14px) scaleY(0.2);
    }
  }
</style>

---
---

<div class="wrap">
  <section id="contact">
    <div class="shead"><span class="n">04</span><h2>Contact</h2><span class="rule"></span></div>
    <div class="contact">
      <div>
        <div class="big">let's <span class="a">talk.</span></div>
        <p class="intro">Always up for a good problem — freelance or full-time. Reach me directly:</p>
        <a class="mail" href="mailto:ndr@nuuk.de" data-h>ndr@nuuk.de</a>
      </div>
      <form
        name="contact-portfolio"
        method="post"
        netlify-honeypot="bot-field"
        data-netlify="true"
        action="/success"
      >
        <input type="hidden" name="form-name" value="contact-portfolio" />
        <input type="hidden" name="bot-field" />
        <div class="field">
          <label for="n">Name</label>
          <input id="n" name="name" required placeholder="jane developer" autocomplete="name" />
        </div>
        <div class="field">
          <label for="e">Email</label>
          <input id="e" name="email" type="email" required placeholder="jane@company.com" autocomplete="email" />
        </div>
        <div class="field">
          <label for="m">Message</label>
          <textarea id="m" name="message" rows="3" required placeholder="a line about the project…"></textarea>
        </div>
        <button type="submit" data-h>send message →</button>
      </form>
    </div>
  </section>
</div>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .contact .big {
    font-size: clamp(34px, 5.4vw, 60px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .contact .big .a {
    color: var(--acc);
  }

  .contact .intro {
    color: var(--dim);
    margin-top: 22px;
    max-width: 380px;
    font-size: 16px;
  }

  .contact .mail {
    margin-top: 28px;
    display: inline-flex;
    gap: 11px;
    font-family: var(--font-mono);
    font-size: clamp(15px, 2.4vw, 20px);
    color: var(--acc);
    border-bottom: 1px solid var(--acc);
    padding-bottom: 5px;
  }

  form .field {
    margin-bottom: 26px;
  }

  form label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 10px;
  }

  form input,
  form textarea {
    width: 100%;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    padding: 7px 0;
    outline: none;
    transition: border-color 0.25s;
    resize: none;
  }

  form input:focus,
  form textarea:focus {
    border-color: var(--acc);
  }

  form input::placeholder,
  form textarea::placeholder {
    color: var(--faint);
  }

  form button {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--bg);
    background: var(--acc);
    border: 0;
    padding: 13px 24px;
    transition: 0.2s;
    display: inline-flex;
    gap: 10px;
  }

  form button:hover {
    gap: 15px;
  }

  @media (max-width: 760px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

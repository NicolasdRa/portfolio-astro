---
import about from "../../constants/about";

const { paragraphs, stack } = about;
---

<div class="wrap">
  <section id="about">
    <div class="shead"><span class="n">01</span><h2>About</h2><span class="rule"></span></div>
    <div class="about-lead">design and engineering —<br /><span class="a">no handoff</span> in between.</div>
    <div class="about-grid">
      <div>
        {paragraphs.map((p) => <p set:html={p} />)}
      </div>
      <dl class="stack">
        {stack.map((row) => (
          <div class="srow">
            <dt>{row.label}</dt>
            <dd>{row.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</div>

<style>
  .about-lead {
    font-size: clamp(26px, 4.4vw, 44px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.14;
    max-width: 16ch;
    margin-bottom: 44px;
  }

  .about-lead .a {
    color: var(--acc);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .about-grid p {
    color: var(--dim);
    font-size: 16px;
    margin-bottom: 16px;
  }

  .about-grid p :global(b) {
    color: var(--ink);
    font-weight: 500;
  }

  .stack {
    display: grid;
    gap: 0;
  }

  .stack .srow {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 18px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }

  .stack .srow:last-child {
    border-bottom: 1px solid var(--line);
  }

  .stack dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .stack dd {
    font-size: 15.5px;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

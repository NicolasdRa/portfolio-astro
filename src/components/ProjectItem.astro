---
import Icon from './Icon.astro';

interface Props {
  project: {
    id: number | string;
    title: string;
    summary?: string;
    featured?: boolean;
    description: string;
    stack: Array<{ name: string }>;
    web?: string;
    url?: string;
    github?: string;
    image?: {
      src: string;
      width: number;
      height: number;
      format: string;
    } | string;
    slug?: string;
    tag?: string;
  };
}

const { project } = Astro.props;
const { title, featured, summary, web, url, github, description, stack, image } = project;

// Use 'url' if 'web' is not defined
const websiteUrl = web || url;

// Get image source from the Astro image object or string
const imageSrc = typeof image === 'string' ? image : image?.src;
const imageWidth = typeof image === 'string' ? undefined : image?.width;
const imageHeight = typeof image === 'string' ? undefined : image?.height;
const hasImage = imageSrc && imageSrc.trim() !== '';
---

<div class="container">
  <div class="project-block">
    {hasImage && (
      <img
        src={imageSrc}
        alt={title}
        class="image"
        width={imageWidth}
        height={imageHeight}
        loading="lazy"
      />
    )}
    <div class="info">
      {featured && <span class="featured">featured</span>}
      <h4>{title}</h4>
      {summary && (
        <h5>
          <span class="summary">{summary}</span>
        </h5>
      )}
      <p class="description">{description}</p>

      <div class="stack">
        {stack.map((item) => (
          <span class="stack-item">
            {item.name}
          </span>
        ))}
      </div>

      <div class="links">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noreferrer"
            aria-label={`View ${title} on Github`}
            class="project-link"
            data-cursor-hover="social"
          >
            <Icon name="github" class="project-icon" />
          </a>
        )}
        {websiteUrl && (
          <a
            href={websiteUrl}
            target="_blank"
            rel="noreferrer"
            aria-label={`Visit ${title} website`}
            class="project-link"
            data-cursor-hover="social"
          >
            <Icon name="web" class="project-icon" />
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .container {
    width: 100%;
  }

  .container h4 {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .container h5 {
    font-family: var(--font-primary);
    margin-bottom: 1rem;
  }

  .project-block {
    margin-top: 2.5rem;
    margin-bottom: 6.5rem;
    display: flex;
    justify-content: space-between;
  }

  .image {
    width: 45%;
    height: 300px;
    object-fit: cover;
  }

  .info {
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .featured {
    color: var(--color-grey-3);
    font-weight: 700;
  }

  .summary {
    font-size: 1rem;
  }

  .description {
    margin-top: 0.875rem;
    text-align: left;
  }

  .stack {
    margin: 1.25rem 1.25rem 1.25rem 0;
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width: 600px;
  }

  .stack-item {
    font-size: 0.875rem;
    font-style: italic;
    margin-right: 1.25rem;
    margin-bottom: 0.5rem;
    white-space: nowrap;
  }

  .stack-item:last-child {
    margin-right: 0;
  }

  .links {
    margin-top: 1.25rem;
    display: flex;
    justify-content: flex-start;
  }

  .project-link {
    height: 1.5rem;
    margin-right: 2rem;
    color: var(--color-grey-1);
    transition: var(--transition-fast);
  }

  .project-link :global(.project-icon) {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .project-link:hover {
    color: var(--color-primary-4);
    transform: translateY(-2px);
    transition: var(--transition-fast);
    cursor: none;
  }

  .project-link:active {
    color: var(--color-primary-3);
    transform: translateY(1px);
    transition: transform 125ms;
  }

  @media screen and (max-width: 960px) {
    .image {
      height: 200px;
    }

    .container p {
      font-size: 0.875rem;
      line-height: 1.8;
    }

    .stack {
      flex-wrap: wrap;
      margin: 1.25rem 1.25rem 1.25rem 0;
    }

    .stack-item {
      margin: 0.85rem 1.25rem 0.85rem 0;
    }

    .project-block {
      margin: 2.5rem 0 3.75rem 0;
    }

    .links {
      margin-top: 0;
    }
  }

  @media screen and (max-width: 600px) {
    .container h4 {
      font-size: 1.25rem;
    }

    .container h5 {
      font-size: 0.875rem;
    }

    .project-block {
      margin: 2.5rem 0;
      flex-direction: column;
      justify-content: flex-start;
      width: 100%;
    }

    .image {
      display: none;
    }

    .info {
      margin-left: 0;
      width: 100%;
    }

    .stack {
      flex-wrap: wrap;
    }

    .stack-item {
      margin: 0 1.5rem 0.875rem 0;
    }
  }
</style>

<script>
  function initProjectLinks() {
    const projectLinks = document.querySelectorAll('[data-cursor-hover="social"]');
    const setCursorType = (window as any).__cursorStore__?.setCursorType;

    if (!setCursorType) return;

    projectLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        setCursorType('hover-social');
      });

      link.addEventListener('mouseleave', () => {
        setCursorType('default');
      });
    });
  }

  // Initialize on page load
  initProjectLinks();

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:page-load', () => {
    initProjectLinks();
  });
</script>

<div class="rail">
  <div class="rl"><span class="d" aria-hidden="true"></span>Shipping since '21</div>
  <div class="idx">Berlin · 52.5°N</div>
</div>

<style>
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 46px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    pointer-events: none;
  }

  .rail .rl {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .rail .rl .d {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--acc);
    margin-bottom: 12px;
  }

  .rail .idx {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .rail {
      display: none;
    }
  }
</style>

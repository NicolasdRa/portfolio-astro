---
import socialLinks from "../constants/social_links";

const year = new Date().getFullYear();
---

<div class="wrap">
  <footer>
    <div class="soc">
      {socialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer" data-h aria-label={link.name}>
          {link.name.toLowerCase()}
        </a>
      ))}
      <a href="/cv-nicolasdirago.pdf" download data-h>cv &darr;</a>
    </div>
    <div class="cr">Nicolás di Rago · Berlin · &copy; {year}</div>
  </footer>
</div>

<style>
  footer {
    padding: 40px 0 54px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .soc {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  footer a {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--dim);
  }

  footer a:hover {
    color: var(--acc);
  }

  .cr {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
  }
</style>

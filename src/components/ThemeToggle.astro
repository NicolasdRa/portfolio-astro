<div class="theme-toggle-container">
  <button
    id="themeToggle"
    class="theme-toggle-button"
    data-cursor-hover="hover"
    aria-label="Toggle theme"
    title="Toggle theme"
  >
    <span id="themeText">light</span>
  </button>
</div>

<style>
  .theme-toggle-container {
    position: fixed;
    bottom: 1.875rem;
    right: 1.875rem;
    z-index: 200;
    opacity: 0;
    animation: fadeIn 0.3s ease-out forwards;
    animation-delay: 0.1s;
  }

  .theme-toggle-button {
    background: none;
    border: none;
    color: var(--color-gray-2);
    font-family: var(--font-primary);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 0.3125rem 0.625rem;
    transition: color 0.3s ease, transform 0.3s ease;
    text-transform: lowercase;
    cursor: none;
    position: relative;
    will-change: transform;
  }

  .theme-toggle-button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-primary-3);
    transition: width 0.3s ease;
  }

  .theme-toggle-button:hover {
    color: var(--color-primary-3);
    transform: translateX(-2px);
  }

  .theme-toggle-button:hover::after {
    width: 100%;
  }

  .theme-toggle-button:active {
    transform: translateX(0);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Hide on mobile/tablet - only show on desktop */
  @media (max-width: 1024px) {
    .theme-toggle-container {
      display: none;
    }
  }
</style>

<script>
  const button = document.getElementById('themeToggle');
  const themeText = document.getElementById('themeText');

  function updateButtonText() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
    if (themeText) {
      themeText.textContent = nextTheme;
    }
    if (button) {
      button.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
    }
  }

  function handleToggleClick() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';

    // Update DOM and localStorage
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('portfolio-theme-mode', newTheme);

    // Update button text
    updateButtonText();

    // Dispatch event for other components
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
  }

  // Initialize button text
  updateButtonText();

  // Handle toggle click
  button?.addEventListener('click', handleToggleClick);

  // Cursor hover integration
  const setCursorType = (window as any).__cursorStore__?.setCursorType;
  if (setCursorType && button) {
    button.addEventListener('mouseenter', () => setCursorType('hover'));
    button.addEventListener('mouseleave', () => setCursorType('default'));
  }

  // Listen for external theme changes
  window.addEventListener('theme-changed', updateButtonText as EventListener);

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:page-load', () => {
    updateButtonText();
  });
</script>
